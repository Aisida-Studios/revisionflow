{
  "name": "revisionflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "curriculum:manifest": "node scripts/curriculum/build-manifest.mjs",
    "curriculum:validate": "node scripts/curriculum/validate.mjs",
    "curriculum:report": "node scripts/curriculum/report.mjs",
    "curriculum:links": "node scripts/curriculum/check-links.mjs",
    "test:curriculum": "node --test tests/curriculum/curriculum.test.mjs",
    "test:utils": "esbuild tests/utils.test.js --bundle --platform=node --format=esm --outfile=.test-build/utils.test.mjs --log-level=error && node .test-build/utils.test.mjs"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "firebase": "^10.12.0",
    "framer-motion": "^11.2.10",
    "ical.js": "^2.0.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.383.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-calendar": "^5.0.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.2.11"
  }
}
